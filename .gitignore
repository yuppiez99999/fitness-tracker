# ============================================================
# 健身监控项目 - .gitignore
# ============================================================

# ── 1. 敏感数据与个人健康信息 ──────────────────────────
*.env
*.env.local
config/*.json
data/*.json
*.log
*.tmp

# ── 2. Python 缓存与虚拟环境 ──────────────────────────
__pycache__/
*.py[cod]
*.cache
.venv/
venv/
env/

# ── 3. 大文件与模型 ─────────────────────────────────────
*.pth
*.pt
*.parquet
*.h5
*.pkl

# ── 4. IDE / 编辑器 ─────────────────────────────────────
.vscode/
.idea/
.claude/
.ipynb_checkpoints/

# ── 5. 系统文件 ─────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── 6. 文档与报告（本地数据相关） ──────────────────────
*.docx
*.pdf

# ── 7. 其他项目目录（父仓库遗留） ──────────────────────
../*
