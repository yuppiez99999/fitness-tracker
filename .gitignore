# ============================================================
# 健身监控项目 - .gitignore
# ============================================================

# ── 1. 敏感数据与个人健康信息 ──────────────────────────
*.env
*.env.local
config/*.json
data/*.json
*.log
*.tmp

# 个人健康数据（体重、体脂、Excel 记录等）
*.xlsx
*.xls
体脂*.txt
*体重*.txt
*体脂*.txt
*减脂*.xlsx
*全量数据*.xlsx
*变化记录*.xlsx

# ── 2. Python 缓存与虚拟环境 ──────────────────────────
__pycache__/
*.py[cod]
*.cache
.venv/
venv/
env/

# ── 3. 大文件与模型 ─────────────────────────────────────
*.pth
*.pt
*.parquet
*.h5
*.pkl

# ── 4. IDE / 编辑器 ─────────────────────────────────────
.vscode/
.idea/
.claude/
.ipynb_checkpoints/

# ── 5. 系统文件 ─────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── 6. 文档与报告（本地数据相关） ──────────────────────
*.docx
*.pdf

# ── 7. 临时/测试文件 ──────────────────────────────────
temp_*/
*temp*
scan_out.txt
scan_result.txt

# ── 8. 独立子仓库 ──────────────────────────────────────
fitness-tracker/

# ── 9. PyInstaller 打包产物 ────────────────────────────
build/
dist/
*.spec.bak
